{
  "name": "devops-student-feedback-app",
  "version": "1.0.0",
  "description": "Ultra Premium Student Feedback & Analytics Web Application with CI/CD GitHub Actions & Docker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "lint": "eslint src/"
  },
  "keywords": [
    "devops",
    "student-feedback",
    "github-actions",
    "cicd",
    "docker",
    "express",
    "nodejs"
  ],
  "author": "DevOps Engineer Assessment",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.3.0",
    "express": "^4.21.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
